  "proposed_mitigations": [
    {
      "id": "mitigation_1_minus_vision_fallback",
      "title": "Fallback to fusion_minus_vision when vision embedding is out-of-distribution",
      "description": "When a screenshot is detected as an unstyled raw render, blank viewport, or out-of-distribution (e.g. Mahalanobis distance or cosine similarity to training centroid > threshold), route the prediction to fusion_minus_vision_model instead of fusion_full_model. As shown in the metrics, fusion_minus_vision achieves higher accuracy and avoids false-positive visual spikes from unstyled DOMs."
    },
    {
      "id": "mitigation_2_vision_weight_dampening",
      "title": "Confidence-weighted vision discounting",
      "description": "In live Chrome extension execution, dynamic pages with failed CDN resources or short viewports can scale down the vision weight in fusion proportional to the detected resource failure count or DOM text-to-html ratio."
    },
    {
      "id": "mitigation_3_retrain_augmentation",
      "title": "Train with viewport crop and unstyled DOM augmentation (Future Part B)",
      "description": "Augment the training dataset by adding viewport-cropped and CSS-stripped variants to the vision training set so the ResNet backbone learns invariant structural features rather than relying on full-page styling cues."
    }
  ],
